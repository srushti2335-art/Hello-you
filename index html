<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
<title>Hello, You.</title>

<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital@0;1&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">

<style>
:root {
  --black: #0b0b0b;
  --red: #7a0c0c;
  --wine: #2b0707;
  --text: #e5e5e5;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  background: var(--black);
  color: var(--text);
  font-family: 'Inter', sans-serif;
  overflow-x: hidden;
}

section {
  min-height: 100vh;
  padding: 70px 8vw;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

h1, h2 {
  font-family: 'Playfair Display', serif;
  font-weight: 400;
}

.hero h1 {
  font-size: clamp(42px, 8vw, 72px);
}

.fade {
  opacity: 0;
  transform: translateY(20px);
  transition: all 1.2s ease;
}

.fade.show {
  opacity: 1;
  transform: translateY(0);
}

/* Typing */
.typing {
  font-size: 20px;
  line-height: 1.7;
  max-width: 750px;
  margin-bottom: 20px;
}

/* Cards */
.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 20px;
}

.card {
  background: var(--wine);
  border: 1px solid var(--red);
  padding: 20px;
  font-style: italic;
}

/* Click reveal */
.secret {
  background: #130404;
  border-left: 4px solid var(--red);
  padding: 18px;
  margin-bottom: 15px;
  cursor: pointer;
}

.secret span {
  display: none;
  font-style: italic;
  opacity: 0.85;
}

/* Gallery */
.gallery {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(140px,1fr));
  gap: 15px;
}

.gallery img {
  width: 100%;
  height: 220px;
  object-fit: cover;
  filter: grayscale(40%) contrast(115%);
  border: 1px solid var(--red);
}

/* Easter egg */
#egg {
  opacity: 0.05;
  font-size: 12px;
  text-align: center;
  margin-top: 40px;
  cursor: pointer;
}

/* Mobile */
@media(max-width:600px){
  section { padding: 60px 6vw; }
}
</style>
</head>

<body>

<!-- HERO -->
<section class="hero fade">
  <h1>Hello, you.</h1>
  <p><em>I tried waiting. I failed.</em></p>
</section>

<!-- INNER MONOLOGUE -->
<section class="fade">
  <h2>It starts like this.</h2>
  <div class="typing" data-text="You don’t demand attention. You just take it. Quietly."></div>
  <div class="typing" data-text="I notice things. About you especially."></div>
  <div class="typing" data-text="Loving you doesn’t feel sudden. It feels inevitable."></div>
</section>

<!-- OBSESSION -->
<section class="fade">
  <h2>Let’s be honest.</h2>
  <div class="cards">
    <div class="card">I think about you more than I admit.</div>
    <div class="card">You live in my head like you belong there.</div>
    <div class="card">I didn’t fall. I chose.</div>
    <div class="card">And I’d choose you again.</div>
  </div>
</section>

<!-- CLICK TO REVEAL -->
<section class="fade">
  <h2>If you’re wondering…</h2>

  <div class="secret">Click if you ever doubt yourself
    <span>You are deeply wanted. Even on days you feel invisible.</span>
  </div>

  <div class="secret">Click if you feel overwhelmed
    <span>I’m not going anywhere. You don’t have to carry everything alone.</span>
  </div>

  <div class="secret">Click if you miss me
    <span>I miss you too. Constantly. Relentlessly.</span>
  </div>
</section>

<!-- GALLERY -->
<section class="fade">
  <h2>Visual references</h2>
  <p style="opacity:0.6;">Because we both know the vibe.</p>

  <div class="gallery">
    <!-- Joe / Love Quinn–coded -->
    <img src="https://images.unsplash.com/photo-1500917293891-ef795e70e1f6">
    <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9">
    <img src="https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e">
    <img src="https://images.unsplash.com/photo-1520975916090-3105956dac38">
  </div>
</section>

<!-- BIRTHDAY -->
<section class="fade">
  <h2>Happy almost-birthday.</h2>
  <p class="typing" data-text="I see you. Completely. And I’m not looking away."></p>
</section>

<!-- FINAL -->
<section class="fade">
  <h2>Still here?</h2>
  <p><em>Good. I was hoping you would be.</em></p>

  <div id="egg">tap 3 times</div>
</section>

<script>
// Fade on scroll
const fades = document.querySelectorAll('.fade');
const observer = new IntersectionObserver(entries => {
  entries.forEach(e => e.isIntersecting && e.target.classList.add('show'));
});
fades.forEach(f => observer.observe(f));

// Typing animation
document.querySelectorAll('.typing').forEach(el => {
  let text = el.dataset.text;
  let i = 0;
  function type(){
    if(i < text.length){
      el.textContent += text.charAt(i);
      i++;
      setTimeout(type, 40);
    }
  }
  type();
});

// Click reveal
document.querySelectorAll('.secret').forEach(sec=>{
  sec.addEventListener('click',()=>{
    sec.querySelector('span').style.display = 'block';
  });
});

// Easter egg
let clicks = 0;
document.getElementById('egg').onclick = () => {
  clicks++;
  if(clicks === 3){
    alert("You’re it for me. No plot twist.");
  }
};
</script>

</body>
</html>
